// Application icon of camera-gui.exe. scripts/build-wsl.sh and scripts/build.ps1 compile this
// file from the repository root with windres into cmd/camera-gui/rsrc_windows_amd64.syso.
// GLFW_ICON is the window and taskbar icon (GLFW looks it up by this name); group 1 is what
// Explorer shows for the file.
GLFW_ICON ICON "assets/icons/studio.ico"
1 ICON "assets/icons/studio.ico"
