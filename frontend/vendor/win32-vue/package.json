{
  "name": "@win32-vue/win32",
  "version": "0.1.0",
  "description": "Retro Win32 / industrial-control UI component library for Vue 3 (Wails desktop apps)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/win32-vue.umd.cjs",
  "module": "./dist/win32-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/win32-vue.js",
      "require": "./dist/win32-vue.umd.cjs"
    },
    "./styles/win32.css": "./src/styles/win32.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/bevel.css": "./src/styles/bevel.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
